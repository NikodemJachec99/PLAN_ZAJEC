# Public port exposed by docker compose on Mikrus
APP_PORT=30225

# URL printed at end of deploy.sh
APP_URL=https://patryk225-30225.wykr.es

TZ=Europe/Warsaw
ALLOWED_ORIGINS=https://patryk225-30225.wykr.es,https://patryk225-30225.mikrus.cloud,http://localhost:5173,http://127.0.0.1:5173

# Strona WNoZ z plikami planu (oba pliki .xlsx z tej strony tworzą jeden plan).
SOURCE_PAGE_URL=https://wnoz.uni.opole.pl/plan-pielegniarstwo-i-stopnia-iii-rok-stacjonarne-1/
# Jak często sprawdzać stronę uczelni (sekundy, min. 30).
SYNC_INTERVAL_SECONDS=300

# Hasło do awaryjnego ręcznego wgrania pliku (/api/v1/admin/upload).
# Puste = funkcja wyłączona. Nie wpisuj tu hasła do publicznego repozytorium.
SETTINGS_PASSWORD=

# Frontend build-time API base.
# Keep empty to use same-origin (/api/*) through nginx proxy.
VITE_API_BASE_URL=
